    "incident_id": "INC-2017-NOTPETYA",
    "name": "NotPetya Cyberattack",
    "category": "Destructive Malware / Wiper",
    "summary": "A destructive malware attack that began in June 2017. NotPetya initially spread through a compromised software update mechanism and used multiple techniques to propagate across networks. Although it appeared to be ransomware, its primary purpose was destructive.",
    "findings": [
      {
        "finding_id": "PET-F001",
        "claim": "The initial NotPetya infection was distributed through a compromised update mechanism associated with the M.E.Doc accounting software.",
        "evidence_status": "supported",
        "source_ids": ["PET-S002", "PET-S003"]
      },
      {
        "finding_id": "PET-F002",
        "claim": "NotPetya used SMB-related vulnerabilities, including EternalBlue and EternalRomance, to spread across vulnerable Windows systems.",
        "evidence_status": "supported",
        "source_ids": ["PET-S001", "PET-S002"]
      },
      {
        "finding_id": "PET-F003",
        "claim": "NotPetya used credential theft and network administration tools to support lateral movement across infected networks.",
        "evidence_status": "supported",
        "source_ids": ["PET-S001", "PET-S002"]
      },
      {
        "finding_id": "PET-F004",
        "claim": "Although NotPetya appeared to be ransomware, its destructive behaviour meant it was better characterised as a wiper.",
