{
  "incident_id": "INC-2021-JBS",
  "name": "JBS Foods REvil Ransomware Attack",
  "category": "Ransomware / Food Supply Chain",
  "summary": "On May 30, 2021, JBS USA experienced a cyberattack affecting servers supporting its North American and Australian IT systems. The FBI attributed the attack to REvil, also known as Sodinokibi. The incident disrupted operations at several facilities, although the company restored production using unaffected backup systems.",
  "findings": [
    {
      "finding_id": "JBS-F001",
      "claim": "JBS USA identified a cybersecurity attack on May 30, 2021, affecting servers supporting its North American and Australian IT systems.",
      "evidence_status": "supported",
      "source_ids": ["JBS-S001"]
    },
    {
      "finding_id": "JBS-F002",
      "claim": "The FBI attributed the JBS cyberattack to the REvil and Sodinokibi ransomware operation.",
      "evidence_status": "supported",
      "source_ids": ["JBS-S002"]
    },
    {
      "finding_id": "JBS-F003",
      "claim": "JBS temporarily shut down affected systems to isolate the intrusion and limit potential infection.",
      "evidence_status": "supported",
      "source_ids": ["JBS-S001", "JBS-S003"]
    },
    {
      "finding_id": "JBS-F004",
      "claim": "JBS stated that its backup servers were not affected by the attack and helped the company restore operations.",
      "evidence_status": "supported",
      "source_ids": ["JBS-S001", "JBS-S003"]
    },
    {
      "finding_id": "JBS-F005",
      "claim": "JBS announced that all its global facilities were fully operational by June 3, 2021.",
      "evidence_status": "supported",
      "source_ids": ["JBS-S003"]
    },
    {
      "finding_id": "JBS-F006",
      "claim": "JBS USA confirmed that it paid an $11 million ransom following the cyberattack.",
      "evidence_status": "supported",
      "source_ids": ["JBS-S004"]
    }
  ],
