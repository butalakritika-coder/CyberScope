{
  "incident_id": "INC-2019-NORSK-HYDRO",
  "name": "Norsk Hydro LockerGoga Ransomware Attack",
  "category": "Ransomware",
  "summary": "On March 19, 2019, Norwegian aluminium producer Norsk Hydro experienced a major cyberattack involving LockerGoga ransomware. The incident affected the organisation globally, with its Extruded Solutions business experiencing particularly significant operational disruption and financial losses.",
  "findings": [
    {
      "finding_id": "HYD-F001",
      "claim": "Norsk Hydro experienced a significant cyberattack on March 19, 2019.",
      "evidence_status": "supported",
      "source_ids": ["HYD-S001", "HYD-S002"]
    },
    {
      "finding_id": "HYD-F002",
      "claim": "The attack involved LockerGoga ransomware, which encrypted files on computers and servers.",
      "evidence_status": "supported",
      "source_ids": ["HYD-S002", "HYD-S003"]
    },
    {
      "finding_id": "HYD-F003",
      "claim": "The attack affected Norsk Hydro employees across 40 countries.",
      "evidence_status": "supported",
      "source_ids": ["HYD-S002"]
    },
    {
      "finding_id": "HYD-F004",
      "claim": "The attack caused production disruptions and financial losses, with the estimated financial impact reaching NOK 650–750 million.",
      "evidence_status": "supported",
      "source_ids": ["HYD-S001"]
    },
    {
      "finding_id": "HYD-F005",
      "claim": "Norsk Hydro decided not to pay the ransom and worked with cybersecurity specialists to restore operations.",
      "evidence_status": "supported",
