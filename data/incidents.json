{
  "incident_id": "INC-2021-COLONIAL",
  "name": "Colonial Pipeline DarkSide Ransomware Attack",
  "category": "Ransomware / Critical Infrastructure",
  "summary": "On May 7, 2021, Colonial Pipeline experienced a ransomware attack that led the company to temporarily shut down its pipeline operations. The FBI attributed the attack to the DarkSide ransomware group. Attackers reportedly gained initial access through a compromised VPN account using valid credentials. The incident disrupted fuel distribution across parts of the eastern United States.",
  "findings": [
    {
      "finding_id": "COL-F001",
      "claim": "Colonial Pipeline experienced a ransomware attack on May 7, 2021.",
      "evidence_status": "supported",
      "source_ids": ["COL-S001", "COL-S002"]
    },
    {
      "finding_id": "COL-F002",
      "claim": "The FBI confirmed that DarkSide ransomware was responsible for compromising Colonial Pipeline's networks.",
      "evidence_status": "supported",
      "source_ids": ["COL-S001"]
    },
    {
      "finding_id": "COL-F003",
      "claim": "Colonial Pipeline proactively shut down its pipeline system in response to the ransomware attack.",
      "evidence_status": "supported",
      "source_ids": ["COL-S002"]
    },
    {
      "finding_id": "COL-F004",
      "claim": "The company paid a ransom of approximately 75 bitcoins following the attack.",
      "evidence_status": "supported",
      "source_ids": ["COL-S003"]
    },
    {
      "finding_id": "COL-F005",
      "claim": "Colonial Pipeline announced that its entire pipeline system had restarted on May 13, 2021.",
      "evidence_status": "supported",
      "source_ids": ["COL-S002"]
    },
    {
      "finding_id": "COL-F006",
      "claim": "The United States Department of Justice announced the seizure of approximately 63.7 bitcoins associated with the ransom payment.",
      "evidence_status": "supported",
      "source_ids": ["COL-S003"]
    },
    {
      "finding_id": "COL-F007",
      "claim": "Attackers reportedly gained initial access through a VPN account associated with an expired account and valid credentials.",
      "evidence_status": "supported",
      "source_ids": ["COL-S004"]
    }
  ],
  "techniques": [
    {
