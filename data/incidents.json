{
  "incident_id": "INC-2020-GARMIN",
  "name": "Garmin Ransomware Attack",
  "category": "Ransomware",
  "summary": "In July 2020, Garmin experienced a ransomware attack that disrupted several of its online services and internal systems. Services including Garmin Connect, flyGarmin and customer support were affected. External cybersecurity reporting identified the ransomware as WastedLocker.",
  "findings": [
    {
      "finding_id": "GAR-F001",
      "claim": "Garmin experienced a major service outage beginning on July 23, 2020.",
      "evidence_status": "supported",
      "source_ids": ["GAR-S001", "GAR-S002"]
    },
    {
      "finding_id": "GAR-F002",
      "claim": "Garmin confirmed that the incident involved a ransomware attack that encrypted some of its systems.",
      "evidence_status": "supported",
      "source_ids": ["GAR-S001"]
    },
    {
      "finding_id": "GAR-F003",
      "claim": "The outage affected Garmin Connect, its website and customer support services.",
      "evidence_status": "supported",
      "source_ids": ["GAR-S001", "GAR-S002"]
    },
    {
      "finding_id": "GAR-F004",
      "claim": "External cybersecurity reporting identified the ransomware involved as WastedLocker.",
      "evidence_status": "supported",
      "source_ids": ["GAR-S002", "GAR-S003"]
    },
    {
      "finding_id": "GAR-F005",
      "claim": "Garmin stated that it had no indication that customer activity, payment or other personal information had been affected by the outage.",
      "evidence_status": "supported",
      "source_ids": ["GAR-S001"]
    }
  ],
  "techniques": [
